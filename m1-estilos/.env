# ==============================================================================
# Variables de entorno para el Módulo 1 (m1-estilos)
# ==============================================================================

# Modo de consistencia para monolito y clean (CP o AP)
CONSISTENCIA_MODO=CP

# Canal de envío de notificaciones (CONSOLA o CORREO)
NOTIFICACIONES_CANAL=CONSOLA

# Simulación de falla en el adaptador/servicio de notificaciones (true o false)
NOTIFICACIONES_SIMULAR_FALLA=false

