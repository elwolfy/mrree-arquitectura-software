        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(consular_emision_duracion_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
