# ==============================================================================
# .editorconfig — mrree-arquitectura-software
# ==============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{ts,js,html,css,scss,json,yaml,yml,sql,md,xml}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf
