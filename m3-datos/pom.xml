<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>pe.utec.consular</groupId>
    <artifactId>m3-datos</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>m3-datos :: Agregador de Gestion de Datos y Consistencia</name>
    <description>Módulo 3: CQRS, Event Sourcing, Saga orquestada, Outbox, Idempotencia y Redis</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versiones de dependencias y BOMs según contrato global (ADR-000) -->
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <spring-modulith.version>1.3.3</spring-modulith.version>
        <testcontainers.version>1.20.5</testcontainers.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <springdoc.version>2.8.5</springdoc.version>
        <archunit.version>1.4.1</archunit.version>
        <jacoco.version>0.8.12</jacoco.version>
        <grpc.version>1.68.2</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
    </properties>

    <modules>
        <module>citas-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Modulith BOM -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j BOM -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- OpenAPI / Swagger Documentation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ArchUnit JUnit 5 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludedGroups>integracion</excludedGroups>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <groups>integracion</groups>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>modulo-tramites</id>
            <activation>
                <file>
                    <exists>tramites-service/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>tramites-service</module>
            </modules>
        </profile>
        <profile>
            <id>modulo-identidad</id>
            <activation>
                <file>
                    <exists>identidad-service/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>identidad-service</module>
            </modules>
        </profile>
        <profile>
            <id>modulo-notificaciones</id>
            <activation>
                <file>
                    <exists>notificaciones-service/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>notificaciones-service</module>
            </modules>
        </profile>
        <profile>
            <id>modulo-pagos</id>
            <activation>
                <file>
                    <exists>pagos-service/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>pagos-service</module>
            </modules>
        </profile>
        <profile>
            <id>modulo-emision</id>
            <activation>
                <file>
                    <exists>emision-service/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>emision-service</module>
            </modules>
        </profile>
        <profile>
            <id>modulo-bff-web</id>
            <activation>
                <file>
                    <exists>bff-web/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>bff-web</module>
            </modules>
        </profile>
        <profile>
            <id>modulo-gateway</id>
            <activation>
                <file>
                    <exists>gateway/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>gateway</module>
            </modules>
        </profile>
        <profile>
            <id>cobertura</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
